# Known-safe matches for scripts/secret-scan.sh. One ripgrep regex per line.
# Keep each entry as narrow as possible and explain it.

# Test fixture: placeholder token in a deep-link parsing test.
example\.com/sub\?token=redacted

# Legacy deep-link fixtures use reserved example.com subdomains, never live providers.
sing-box://import-remote-profile\?url=https%3A%2F%2F(app|sub)\.example\.com%2F

# Documentation and test fixtures use self-describing placeholder credentials.
"(password|passwd|secret|api_key|apikey|private_key)"\s*:\s*"(change-me|REPLACE_WITH_STRONG_PASSWORD|secret|test-password|plain-[a-z]+|[a-z0-9]+-(password|passwd|secret|psk|token))"

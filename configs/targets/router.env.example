# Example only. Copy outside the repository and replace target-specific values.
TARGET_KIND=production
SSH_HOST=192.0.2.1
SSH_PORT=22
SSH_USER=root
SSH_KEY=
API_URL=http://192.0.2.1:3000
REMOTE_DATA_DIR=/etc/smartgate
REMOTE_RUNTIME_DIR=/tmp/smartgate
REMOTE_DEPLOY_DIR=/root/smartgate-deployments
REMOTE_STAGE_DIR=/tmp/smartgate-stage
REQUIRED_WORKER_BINS="sing-box"
OPTIONAL_WORKER_BINS="xray"
REQUIRED_PACKAGES="sing-box kmod-nft-tproxy kmod-nft-socket ip-full conntrack"
OPTIONAL_PACKAGES="xray-core"
